# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ucafe_loyalty
DB_USER=postgres
DB_PASSWORD=change_me

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
CODE_PEPPER=replace_with_another_long_random_secret
REFRESH_TOKEN_PEPPER=replace_with_a_third_long_random_secret
NODE_ENV=production
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true

# Outgoing email. Provider is chosen by priority: Resend > SMTP > dev stub.
#   - RESEND_API_KEY set        -> Resend HTTP API  (use in production; hosts
#                                  like Render free-tier block outgoing SMTP)
#   - otherwise SMTP_* set      -> SMTP via nodemailer (fine for local dev)
#   - otherwise                 -> dev stub (logs the code to the console)
# EMAIL_FROM is required for both Resend and SMTP. With Resend the domain in
# EMAIL_FROM must be verified in your Resend dashboard.
EMAIL_FROM="On the plate <no-reply@your-domain.com>"

# Resend (https://resend.com) — recommended for production.
RESEND_API_KEY=re_your_resend_api_key

# SMTP — local development fallback. For Gmail use smtp.gmail.com, port 465,
# your full Gmail address and a Google "App password" (not your usual password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_character_app_password

# Production HTTP and database limits. Set CORS_ORIGINS to your HTTPS frontend URL.
CORS_ORIGINS=https://app.example.com
PORT=3000
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
