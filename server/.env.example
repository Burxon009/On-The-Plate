# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ucafe_loyalty
DB_USER=postgres
DB_PASSWORD=change_me

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
CODE_PEPPER=replace_with_another_long_random_secret
REFRESH_TOKEN_PEPPER=replace_with_a_third_long_random_secret
NODE_ENV=production
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true

# Outgoing email. Provider is chosen by priority: Brevo > Resend > SMTP > dev stub.
#   - BREVO_API_KEY set         -> Brevo HTTP API   (current production choice)
#   - otherwise RESEND_API_KEY  -> Resend HTTP API  (kept for later; see note)
#   - otherwise SMTP_* set      -> SMTP via nodemailer (fine for local dev)
#   - otherwise                 -> dev stub (logs the code to the console)
# All providers need EMAIL_FROM. It is stored in SMTP format ("Name <addr>");
# the Brevo client parses name and address out of it.
EMAIL_FROM="On the plate <burhanruziev@gmail.com>"

# Brevo (https://brevo.com) — primary provider. Works with just a verified
# single sender (no domain needed), and its HTTP API is not blocked by
# hosts that block outgoing SMTP (e.g. Render free-tier).
BREVO_API_KEY=xkeysib-your_brevo_api_key

# Resend (https://resend.com) — kept in the code for later. Without a
# verified domain Resend only delivers to the account owner's own address,
# so it stays a lower priority than Brevo until a domain is added.
RESEND_API_KEY=re_your_resend_api_key

# SMTP — local development fallback. For Gmail use smtp.gmail.com, port 465,
# your full Gmail address and a Google "App password" (not your usual password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_16_character_app_password

# Telegram Gateway (https://gateway.telegram.org) — доставка кодов входа по
# номеру телефона. Telegram сам генерирует и проверяет 6-значный код
# (мы храним только request_id). Без этого токена вход по email работает,
# вход по телефону — нет. Платный сервис (бесплатно только на свой номер).
TELEGRAM_GATEWAY_TOKEN=AA...your_telegram_gateway_api_token

# Production HTTP and database limits. Set CORS_ORIGINS to your HTTPS frontend URL.
CORS_ORIGINS=https://app.example.com
PORT=3000
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
